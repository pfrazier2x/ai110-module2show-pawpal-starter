
classDiagram
    class Owner {
        +str name
        +list pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +str name
        +int age
        +str pet_type
        +list tasks
        +add_task(task)
    }

    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +date due_date
        +str priority
        +mark_complete()
    }

    class Scheduler {
        +sort_by_time(tasks)
        +filter_tasks(tasks, pet_name, completed)
        +detect_conflicts(tasks)
        +mark_task_complete(pet, task)
    }

    Owner "1" --> "*" Pet : manages
    Pet "1" --> "*" Task : contains
    Scheduler ..> Task : schedules
    Scheduler ..> Pet : updates
